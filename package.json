{
  "name": "bacchus-id",
  "version": "0.0.2-dev",
  "description": "Identity management service for SNUCSE",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "lint": "eslint '{bootstrap,src,test}/**/*.{js,ts}'",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "start": "yarn rebuild-cache && node dist/src/index.js",
    "test": "yarn lint && yarn fmt:check && yarn build && ava --color --verbose",
    "rebuild-cache": "node dist/bootstrap/rebuild_group_cache.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bacchus-snu/id.git"
  },
  "author": "Bacchus <contact@bacchus.snucse.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bacchus-snu/id/issues"
  },
  "type": "module",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@phc/format": "^1.0.0",
    "argon2": "^0.44.0",
    "bunyan": "^1.8.15",
    "ioredis": "^5.3.2",
    "jose": "^5.2.3",
    "koa": "^2.16.4",
    "koa-bodyparser": "^4.4.1",
    "koa-mount": "^4.0.0",
    "moment": "^2.30.1",
    "nodemailer": "^9.0.1",
    "oidc-provider": "^9.9.1",
    "pg": "^8.11.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^11.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bunyan": "^1.8.11",
    "@types/eslint__js": "^8",
    "@types/koa": "^2.15.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-mount": "^4.0.5",
    "@types/koa__cors": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.14",
    "@types/oidc-provider": "^9.5.0",
    "@types/pg": "^8.11.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "ava": "^6.4.1",
    "dprint": "^0.55.2",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "packageManager": "yarn@4.17.1"
}
