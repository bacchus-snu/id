{
  "name": "bacchus-id",
  "version": "0.0.2-dev",
  "description": "Identity management service for SNUCSE",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "lint": "eslint '{bootstrap,src,test}/**/*.{js,ts}'",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "start": "yarn rebuild-cache && node dist/src/index.js",
    "test": "yarn lint && yarn fmt:check && yarn build && ava --color --verbose",
    "rebuild-cache": "node dist/bootstrap/rebuild_group_cache.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bacchus-snu/id.git"
  },
  "author": "Bacchus <contact@bacchus.snucse.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bacchus-snu/id/issues"
  },
  "type": "module",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@phc/format": "^1.0.0",
    "argon2": "^0.45.1",
    "bunyan": "^1.8.15",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-mount": "^4.2.0",
    "moment": "^2.31.0",
    "nodemailer": "^10.2.0",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.1",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bunyan": "^1.8.11",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-mount": "^4.0.5",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.12.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ava": "^8.1.0",
    "dprint": "^0.64.1",
    "eslint": "^10.13.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "yarn@4.18.1"
}
